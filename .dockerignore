# Both images build from the repository root (see docker-compose.yml). The
# backend needs backend/ and data/processed; the frontend needs frontend/,
# tools/ and docs/agent-log. Keep everything else out of the context.
.git
.gitignore
.github
.claude
build
**/.venv
**/__pycache__
**/*.pyc
**/.pytest_cache
**/.coverage
**/htmlcov
**/*.tsbuildinfo
**/.env*
docs/*
!docs/agent-log
data/raw
data/tests
data/pipeline
data/*.py
backend/tests
backend/scripts
frontend/node_modules
frontend/dist
frontend/e2e
frontend/Dockerfile
tools/test_*.py
tools/__pycache__
README.md
docker-compose.yml
deploy.sh
scripts
